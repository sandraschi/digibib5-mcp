{
    "name": "digibib5-mcp",
    "version": "0.1.0",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/digibib5_mcp/server.py",
    "dependencies": [
        "fastmcp>=3.2.0,<4",
        "pydantic>=2.0"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/",
            "web_sota/",
            "reports/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/digibib5-mcp.mcpb",
        "test": "python -m pytest"
    }
}
