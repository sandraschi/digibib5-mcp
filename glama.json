{
  "$schema": "https://glama.ai/schemas/mcp.json",
  "name": "digibib5-mcp",
  "version": "0.5.0",
  "description": "FastMCP Digitale Bibliothek 5 reader: reverse-engineered DKI volumes (TOC, decoded text, FTS search, figure scans) + React/Vite reader (14114/14115).",
  "author": "Sandra Schipal",
  "license": "MIT",
  "language": "python",
  "framework": "fastmcp",
  "type": "mcp_server",
  "status": "beta",
  "transport": ["stdio"],
  "keywords": [
    "digibib",
    "digitale-bibliothek",
    "ebooks",
    "fts5",
    "sqlite",
    "vite",
    "react",
    "fleet"
  ],
  "categories": ["Developer Tools", "AI Agents", "Web Applications"],
  "mcpServers": {
    "digibib5-mcp": {
      "name": "digibib5-mcp",
      "command": "uv",
      "args": ["run", "--directory", "D:/Dev/repos/digibib5-mcp", "python", "-m", "digibib5_mcp"],
      "env": {
        "DIGIBIB_ROOT": "K:/Digitale Bibliothek/Bibliothek"
      },
      "description": "Stdio MCP (default for Claude Desktop / Cursor).",
      "capabilities": {
        "tools": { "enabled": true, "listChanged": true },
        "resources": { "enabled": false },
        "prompts": { "enabled": false },
        "webapp": {
          "enabled": true,
          "url": "http://127.0.0.1:14114",
          "api_url": "http://127.0.0.1:14115"
        }
      }
    }
  }
}
