{
  "manifest_version": "0.2",
  "name": "digibib5-mcp",
  "version": "0.2.0",
  "description": "FastMCP server + reader webapp for Directmedia's Digitale Bibliothek 5 (.DKI) CD-ROM volumes - list the disc library, decode TOC trees and tokenized record text",
  "author": {
    "name": "sandraschi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/digibib5-mcp"
  },
  "server": {
    "type": "python",
    "entry_point": "src/digibib5_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${PWD}", "python", "-m", "digibib5_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1",
        "DIGIBIB_ROOT": "K:/Digitale Bibliothek/Bibliothek"
      }
    }
  },
  "tools": [
    {"name": "digibib"}
  ]
}
